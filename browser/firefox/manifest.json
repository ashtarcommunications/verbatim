{
	"manifest_version": 3,
	"browser_specific_settings": {
		"gecko": {
			"id": "verbatim@paperlessdebate.com",
			"strict_min_version": "126.0"
		}
	},
	"name": "Verbatim",
	"short_name": "Verbatim",
	"version": "1.0.0",
	"description": "Enables keyboard shortcuts for Verbatim extension for Google Docs",
	"author": "support@paperlessdebate.com",
	"homepage_url": "https://paperlessdebate.com",
	"icons": {
		"48": "icons/48.png",
		"128": "icons/128.png"
	},
	"options_page": "options.html",
	"content_scripts": [
		{
			"matches": ["*://docs.google.com/document/*"],
			"js": [
				"vendor/browser-polyfill.min.js",
				"vendor/hotkeys.min.js",
				"verbatim.js"
			],
			"css": ["verbatim.css"]
		}
	],
	"action": {
		"default_icon": {
			"48": "icons/48.png"
		},
		"default_title": "Verbatim",
		"default_popup": "popup.html"
	},
	"permissions":["clipboardRead", "clipboardWrite", "storage", "tabs"]
}
